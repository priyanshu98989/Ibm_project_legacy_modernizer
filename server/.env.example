# Legacy Code Modernizer — Server Environment

# ── Bob AI configuration ──────────────────────────────────────────────────────
# Full URL to the chat completions endpoint. Must be a PUBLIC https URL when
# deployed — localhost resolves to the function's own container and every call
# will time out (the circuit breaker degrades it to "suggestion unavailable").
#
#   Local Ollama:      http://localhost:11434/api/chat
#   Groq (cloud):      https://api.groq.com/openai/v1/chat/completions
#   OpenRouter:        https://openrouter.ai/api/v1/chat/completions
BOB_API_URL=http://localhost:11434/api/chat

# Bearer token for your endpoint (leave blank if not required locally).
BOB_API_KEY=your-bob-api-key-here

# Model name to request. Must match a model the endpoint actually serves.
#   Ollama: check with `ollama list`
#   Groq:   llama-3.3-70b-versatile
BOB_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# How many risky files get AI suggestions (keep low for demo speed).
MAX_BOB_SUGGESTIONS=5

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Upload ────────────────────────────────────────────────────────────────────
# Max ZIP upload size in bytes — default 1 GB
MAX_UPLOAD_BYTES=1073741824

# Zip-bomb guard: max total size the archive may expand to on disk, in bytes.
# A highly compressible archive can be tiny on the wire and enormous extracted.
MAX_EXTRACT_BYTES=4294967296

# Max number of entries inside an archive — default 200000
MAX_EXTRACT_ENTRIES=200000

# Max number of supported source files per repo before analysis is refused.
MAX_FILES=5000

# Max total source text held in memory during analysis, in bytes — default 256 MB.
# This is the real memory guard; MAX_FILES alone does not bound the heap.
MAX_TOTAL_SOURCE_BYTES=268435456

# Per-file Bob suggestion timeout in milliseconds — default 90 s
BOB_SUGGESTION_TIMEOUT_MS=90000

# Temp directory for extracted codebases (absolute path or leave blank for OS temp)
TEMP_DIR=
