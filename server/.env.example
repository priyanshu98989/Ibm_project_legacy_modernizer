# Legacy Code Modernizer — Server Environment

# ── Bob AI configuration ──────────────────────────────────────────────────────
# Full URL to the Bob (or Ollama-compatible) chat completions endpoint.
# REQUIRED — server will refuse to start without this.
BOB_API_URL=http://localhost:11434/api/chat

# Bearer token for your Bob instance (leave blank if not required locally).
BOB_API_KEY=your-bob-api-key-here

# Model name to request from Bob.
BOB_MODEL=granite3.3

# How many risky files get AI suggestions (keep low for demo speed).
MAX_BOB_SUGGESTIONS=5

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Upload ────────────────────────────────────────────────────────────────────
# Max ZIP upload size in bytes — default 50 MB
MAX_UPLOAD_BYTES=52428800

# Max number of supported source files per repo before analysis is refused.
MAX_FILES=500

# Per-file Bob suggestion timeout in milliseconds — default 90 s
BOB_SUGGESTION_TIMEOUT_MS=90000

# Temp directory for extracted codebases (absolute path or leave blank for OS temp)
TEMP_DIR=
